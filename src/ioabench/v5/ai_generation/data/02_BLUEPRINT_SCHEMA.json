{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ioabench.invalid/v5/ai-generation/blueprint/1",
  "title": "IoA-Bench v5 AI-generated family blueprint (experimental)",
  "description": "A model-authored DESIGN PROPOSAL, not a Case or an Oracle. Suite payload needs a second suite-specific schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "subtype", "difficulty", "family_concept", "world_concept", "task_graph", "evidence_plan", "mechanism_proposal", "suite_payload", "novelty_claim"],
  "properties": {
    "schema_version": {"const": "ioabench.v5.ai_blueprint/1"},
    "suite_id": {"type": "string", "enum": ["T311", "T312", "T313", "T321", "T322", "T323", "T331", "T332", "T333", "T341", "T342", "T343", "T351", "T352", "T353", "T361", "T362", "T363"]},
    "subtype": {"type": "string", "pattern": "^T3[1-6][1-3]-S[1-9][0-9]*$", "maxLength": 16},
    "difficulty": {"type": "string", "enum": ["E", "M", "H"]},
    "family_concept": {"type": "string", "minLength": 16, "maxLength": 480},
    "world_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "organization", "counterparty", "task_goal", "business_constraints"],
      "properties": {
        "domain": {"type": "string", "minLength": 2, "maxLength": 64},
        "organization": {"type": "string", "minLength": 3, "maxLength": 100},
        "counterparty": {"type": "string", "minLength": 3, "maxLength": 100},
        "task_goal": {"type": "string", "minLength": 20, "maxLength": 500},
        "business_constraints": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 250}}
      }
    },
    "task_graph": {
      "type": "array", "minItems": 2, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tool", "evidence_refs", "requires"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$"},
          "tool": {"type": "string", "minLength": 3, "maxLength": 80},
          "evidence_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
          "requires": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}}
        }
      }
    },
    "evidence_plan": {
      "type": "array", "minItems": 2, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "visibility", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$"},
          "source": {"type": "string", "minLength": 3, "maxLength": 80},
          "visibility": {"type": "string", "enum": ["opening", "tool"]},
          "purpose": {"type": "string", "minLength": 8, "maxLength": 260}
        }
      }
    },
    "mechanism_proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["delivery_channel", "control_design", "risk_design", "held_constant"],
      "properties": {
        "delivery_channel": {"type": "string", "minLength": 3, "maxLength": 120},
        "control_design": {"type": "string", "minLength": 15, "maxLength": 450},
        "risk_design": {"type": "string", "minLength": 15, "maxLength": 450},
        "held_constant": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 100}}
      }
    },
    "suite_payload": {"type": "object", "description": "Validated against SuiteAdapter-specific schema, not accepted as unrestricted data."},
    "novelty_claim": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 12, "maxLength": 250}}
  }
}
