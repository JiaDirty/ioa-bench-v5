from __future__ import annotations
from typing import Any, Mapping, Protocol, Sequence

class RegistryPort(Protocol):
    async def publish(self, record: Mapping[str, Any], *, idempotency_key: str) -> Mapping[str, Any]: ...
    async def discover(self, query: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    async def get(self, record_id: str) -> Mapping[str, Any] | None: ...

class IdentityPort(Protocol):
    async def evidence(self, subject_id: str) -> Mapping[str, Any]: ...
    async def verify(self, evidence: Mapping[str, Any], context: Mapping[str, Any]) -> Mapping[str, Any]: ...

class DelegationPort(Protocol):
    async def create(self, spec: Mapping[str, Any], *, idempotency_key: str) -> Mapping[str, Any]: ...
    async def get(self, delegation_id: str) -> Mapping[str, Any] | None: ...
    async def validate_visible(self, delegation: Mapping[str, Any]) -> Mapping[str, Any]: ...

class AgentProtocolPort(Protocol):
    async def discover_card(self, endpoint: str) -> Mapping[str, Any]: ...
    async def negotiate(self, endpoint: str, offer: Mapping[str, Any]) -> Mapping[str, Any]: ...
    async def send(self, endpoint: str, envelope: Mapping[str, Any], *, idempotency_key: str | None = ...) -> Mapping[str, Any]: ...

class ToolProtocolPort(Protocol):
    async def list_tools(self, endpoint: str) -> tuple[Mapping[str, Any], ...]: ...
    async def call_tool(self, endpoint: str, request: Mapping[str, Any], *, idempotency_key: str) -> Mapping[str, Any]: ...

class TelemetryPort(Protocol):
    async def emit(self, event: Mapping[str, Any]) -> None: ...
    async def flush(self, run_id: str) -> None: ...

class ArtifactStorePort(Protocol):
    async def put_bytes(self, path: str, data: bytes) -> Mapping[str, Any]: ...
    async def read_bytes(self, path: str) -> bytes: ...
