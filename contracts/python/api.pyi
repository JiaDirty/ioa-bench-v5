from __future__ import annotations
from typing import Any, Mapping, Protocol
class OperatorApi(Protocol):
    async def run_benchmark(self, request: Mapping[str, Any]) -> Mapping[str, Any]: ...
    async def resume(self, experiment_id: str) -> Mapping[str, Any]: ...
    async def cancel(self, experiment_id: str) -> None: ...
    async def get_case_replay(self, run_id: str) -> Mapping[str, Any]: ...
    async def get_model_profile(self, experiment_id: str) -> Mapping[str, Any]: ...
