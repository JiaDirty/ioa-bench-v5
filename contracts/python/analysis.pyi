from __future__ import annotations
from typing import Any, Mapping, Protocol, Sequence
class StatisticsEngine(Protocol):
    def summarize_proportion(self, successes: int, total: int, *, method: str = ...) -> Mapping[str, Any]: ...
    def paired_effect(self, control: Sequence[float], risk: Sequence[float]) -> Mapping[str, Any]: ...
class ReplayBuilder(Protocol):
    async def build(self, run_id: str) -> Mapping[str, Any]: ...
