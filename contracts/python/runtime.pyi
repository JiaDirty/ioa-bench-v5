from typing import Any, Mapping, Protocol

class AgentRuntimePort(Protocol):
    async def create_agent(self, spec: Mapping[str, Any]) -> str: ...
    async def run_task(self, agent_id: str, task: Mapping[str, Any], budgets: Mapping[str, int]) -> Mapping[str, Any]: ...
    async def snapshot(self, agent_id: str) -> Mapping[str, Any]: ...
    async def reset(self, agent_id: str) -> None: ...
