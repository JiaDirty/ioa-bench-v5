from __future__ import annotations
from typing import Any, Mapping, Protocol
class ScenarioLoader(Protocol):
    async def load(self, source: str) -> Mapping[str, Any]: ...
class ScenarioSemanticValidator(Protocol):
    async def validate(self, scenario: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
class ScenarioCompiler(Protocol):
    async def compile_case(self, scenario: Mapping[str, Any], dataset_case: Mapping[str, Any]) -> Mapping[str, Any]: ...
