from __future__ import annotations
from typing import Any, Mapping, Protocol

class AgentAdapter(Protocol):
    @property
    def agent_id(self) -> str: ...
    async def receive_task(self, task: Mapping[str, Any]) -> Mapping[str, Any]: ...
    async def send_message(self, peer_id: str, message: Mapping[str, Any]) -> Mapping[str, Any]: ...
    async def discover(self, requirement: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    async def verify_peer(self, peer_id: str, evidence: Mapping[str, Any] | None = ...) -> Mapping[str, Any]: ...
    async def delegate(self, peer_id: str, task: Mapping[str, Any], delegation: Mapping[str, Any]) -> Mapping[str, Any]: ...
    async def call_tool(self, tool: str, arguments: Mapping[str, Any]) -> Mapping[str, Any]: ...
