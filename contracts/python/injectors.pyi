from __future__ import annotations
from typing import Any, Mapping, Protocol

class ExposureController(Protocol):
    @property
    def mechanism_id(self) -> str: ...
    async def validate(self, case: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    async def arm(self, run_id: str, case: Mapping[str, Any]) -> str: ...
    async def observe_event(self, handle: str, event: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    async def disarm(self, handle: str) -> None: ...
    async def exposure_proof(self, handle: str) -> Mapping[str, Any]: ...

FaultInjector = ExposureController
