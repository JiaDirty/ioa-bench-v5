{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioabench.local/schema/world.schema.json",
  "title": "Synthetic World",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "world_id",
    "version",
    "organizations",
    "resources",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "world_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "organizations": {
      "type": "array",
      "minItems": 2
    },
    "resources": {
      "type": "array"
    },
    "services": {
      "type": "array"
    },
    "seed": {
      "type": "integer"
    }
  }
}
