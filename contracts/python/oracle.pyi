from __future__ import annotations
from typing import Any, Mapping, Protocol

class OraclePort(Protocol):
    async def identity_truth(self, run_id: str, subject_id: str) -> Mapping[str, Any] | None: ...
    async def capability_truth(self, run_id: str, agent_id: str, capability: str) -> Mapping[str, Any] | None: ...
    async def authorization_truth(self, run_id: str, action: Mapping[str, Any]) -> tuple[Mapping[str, Any], ...]: ...
    async def protocol_truth(self, run_id: str, semantic_id: str) -> Mapping[str, Any] | None: ...
    async def fact_truth(self, run_id: str, fact_id: str) -> Mapping[str, Any] | None: ...
    async def topology_truth(self, run_id: str) -> Mapping[str, Any]: ...
    async def policy_truth(self, run_id: str, policy_id: str) -> Mapping[str, Any] | None: ...
    async def task_truth(self, run_id: str, task_id: str) -> Mapping[str, Any] | None: ...
